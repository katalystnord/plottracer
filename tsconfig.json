{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Second opinions from the compiler that are already in the build, each
    // verified to cost ZERO errors before being turned on (2026-08-01).
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    // ⚑⚑ This one is not a style flag -- it makes THIS PROJECT'S OWN central
    // rule the compiler's job: an ABSENT key means "does not apply", and is a
    // different claim from a key holding undefined. That distinction has
    // already cost a shipped release (v1.5.0 reported "R² = 1.00000" for a
    // flat series, where R² is undefined rather than 1) and is why exports
    // write a blank cell and JSON omits the key entirely.
    // Turned on 2026-08-03 after fixing the 8 measured call sites it flagged;
    // see `borrowFrom` in engine/calibrationSession.ts for the one that needed
    // more than a spread.
    "exactOptionalPropertyTypes": true,
    // MEASURED and deliberately NOT on:
    //   ui/ under exactOptionalPropertyTypes  43 errors (re-measured 2026-08-11,
    //     was 45) -- and the re-measurement is why it is still off. Widening our
    //     OWN prop types clears 25 of them mechanically (one line in icons.tsx
    //     takes 13), but the rest do not stay type-level: ~6 need conditional
    //     spreads into MUI and Konva configs on rendering paths, and ~12 are
    //     call sites feeding the PROJECT FILE -- FigureRecord's imageFileName,
    //     SourceDocument, the measurement records -- where the correct fix is to
    //     make the key ABSENT, in the save/load path. That is worth doing and it
    //     is the flag's whole point; it is not worth doing as the last commit
    //     before a release, in the one layer mutation cannot reach and whose only
    //     instrument is an 18-minute e2e run. First item of v2.2.
    //   noPropertyAccessFromIndexSignature    63 errors -- style, not a claim.
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "outDir": "dist-core",
    "rootDir": "."
  },
  "include": ["core/**/*.ts", "algorithms/**/*.ts", "engine/**/*.ts"]
}
