#!/usr/bin/env bash
#
# Refuse a commit that does not typecheck or does not lint.
#
# ⚑ WHY THIS EXISTS. On 2026-08-11 a commit went in with a failing typecheck:
# `Object.hasOwn` and `Array.at` do not compile at this project's ES2020 target,
# the vitest run was green because vitest strips types rather than checking them,
# and `npm run typecheck` simply was not run. It was caught two commits later, by
# hand. The gate existed; it was skipped because the tests were green.
#
# ⚑ AND CI WOULD NOT HAVE CAUGHT IT EITHER - the workflow ran `npm ci` and the
# packager and nothing else, and `vite build` strips types too. This hook is the
# fast half of the fix; `.github/workflows/build.yml`'s `check` job is the half
# that survives a fresh clone and `--no-verify`.
#
# Install (per clone, since git does not ship hooks):
#     git config core.hooksPath tools/git-hooks
#
# ⚑⚑ AND WHY LINT IS HERE TOO, added 2026-08-28. On 2026-08-26 a commit went in
# with one unused variable; its own message asserted "lint 0 errors" from a run
# nobody did, because this hook checked types and em-dashes only. CI's `check`
# job ran lint BEFORE the unit tests, so lint exited 1 and the board did not
# execute in CI for a day. Two orderings were wrong at once - this is the local
# half; splitting the tests into their own CI job is the other.
#
# ⚑ It costs a few seconds and it removes a class of commit message that lies.
# If you are asserting "lint 0 errors" in a commit, something should have run
# lint.
#
# Skipping is deliberate and visible: `git commit --no-verify`.

set -uo pipefail

# ⚑ EM-DASHES FIRST, because it costs milliseconds and applies to every file
# type - a docs-only commit is exactly the one that reintroduces them. David,
# 2026-08-18: *"they should never be used. Ever again."* A style decision that
# lives only in a preference is one nobody can act on later, which is the same
# reason this project turns agreed designs into named tests.
if [ -x "$(git rev-parse --show-toplevel)/tools/no-em-dashes.sh" ]; then
  if ! "$(git rev-parse --show-toplevel)/tools/no-em-dashes.sh"; then
    echo "pre-commit: REFUSED - see above. Or commit deliberately with --no-verify." >&2
    exit 1
  fi
fi

# Only TypeScript can break a typecheck, so a docs- or notes-only commit pays
# nothing. Uses the STAGED list, which is what is about to be committed.
if ! git diff --cached --name-only --diff-filter=ACMR | grep -qE '\.tsx?$'; then
  exit 0
fi

# npm is not on PATH in a bare hook shell on this machine (nvm), so find it the
# same way the project's own notes say to.
if ! command -v npm >/dev/null 2>&1; then
  export NVM_DIR="${NVM_DIR:-$HOME/.nvm}"
  # shellcheck disable=SC1091
  [ -s "$NVM_DIR/nvm.sh" ] && . "$NVM_DIR/nvm.sh" >/dev/null 2>&1
fi
if ! command -v npm >/dev/null 2>&1; then
  echo "pre-commit: npm not found - cannot typecheck. Fix your PATH, or commit with --no-verify." >&2
  exit 1
fi

echo "pre-commit: typechecking (~10s)…"
# ⚠️ This checks the WORKING TREE, not the staged snapshot. Stashing to check the
# index exactly is its own hazard (it can lose work when a hook is interrupted),
# and the working tree is what the author is about to be judged on anyway. Worth
# knowing if you ever stage a subset of your edits.
if ! npm run --silent typecheck; then
  cat >&2 <<'MSG'

pre-commit: REFUSED - the tree does not typecheck.

  A green test run does not mean the code compiles: vitest strips types rather
  than checking them, and so does the production build. That is exactly how a
  broken commit got in before this hook existed.

  Fix it, or commit deliberately with:  git commit --no-verify
MSG
  exit 1
fi

# ⚑ Lint AFTER the typecheck, deliberately: a type error is usually the cause of
# the lint noise, so reporting it first is the more useful message. Unlike CI,
# nothing here is hidden by the ordering - both run on every commit that touches
# TypeScript, and a failure of either refuses the commit on its own.
echo "pre-commit: linting…"
if ! npm run --silent lint; then
  cat >&2 <<'MSG'

pre-commit: REFUSED - the tree does not lint.

  A commit that does not lint blocks the CI `check` job, which blocks the
  packaging and the release. On 2026-08-26 one unused variable did exactly
  that, and the commit that introduced it said "lint 0 errors".

  Fix it, or commit deliberately with:  git commit --no-verify
MSG
  exit 1
fi
exit 0
