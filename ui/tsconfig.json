{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // Kept in step with the root tsconfig -- both were measured at zero errors
    // before being enabled. ui/ compiles core+algorithms+engine too, so a flag
    // set in only one of the two files would be enforced inconsistently.
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "__tests__/**/*.ts", "vite.config.ts", "../core/**/*.ts", "../algorithms/**/*.ts", "../engine/**/*.ts"]
}
